{
  "name": "watq-monorepo",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "pnpm --filter @watq/web dev",
    "dev:mobile": "pnpm --filter @watq/mobile start",
    "build:web": "pnpm --filter @watq/web build",
    "build:mobile": "pnpm --filter @watq/mobile build:android",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@12.11.2"
}
