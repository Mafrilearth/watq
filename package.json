{
  "name": "watq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @watq/web dev",
    "dev:app": "pnpm --filter @watq/app dev",
    "dev:docs": "pnpm --filter @watq/docs dev",
    "build": "turbo build",
    "build:web": "pnpm --filter @watq/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci:check": "biome ci .",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @watq/web test",
    "test:coverage": "pnpm --filter @watq/web test:coverage",
    "test:ui": "pnpm --filter @watq/web test:ui",
    "db:studio": "pnpm --filter @watq/studio dev",
    "postinstall": "pnpm --filter @watq/database db:generate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "lefthook": "^2.2.2",
    "turbo": "^2"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
