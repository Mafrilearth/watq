{
  "name": "watq",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @watq/web dev",
    "dev:app": "pnpm --filter @watq/app dev",
    "dev:docs": "pnpm --filter @watq/docs dev",
    "build": "turbo build",
    "build:web": "pnpm --filter @watq/web build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @watq/web test",
    "db:studio": "pnpm --filter @watq/studio dev"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2"
  },
  "packageManager": "pnpm@12.11.2"
}
