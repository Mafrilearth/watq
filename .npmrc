# ==============================================================================
# WATQ ENTERPRISE PNPM RUNTIME CONFIGURATION (.npmrc)
# Standard: pnpm v9/v10+ Modern Monorepo Best Practices
# ==============================================================================

# 1. Monorepo & Workspace Linking
prefer-workspace-packages=true
link-workspace-packages=deep

# 2. Peer Dependencies Resolution
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true

# 3. Security & Engine Enforcement
engine-strict=true

# 4. Strict Isolated Node Modules (Bans Phantom Dependencies)
# Never use shamefully-hoist in enterprise production
hoist=true
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*
hoist-pattern[]=@types*
hoist-pattern[]=@biomejs*
